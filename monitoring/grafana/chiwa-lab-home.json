   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "min(vrrpOperState{instance=\"192.168.99.252\"})",
     "legendFormat": "IX #1",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(vrrpOperState{instance=\"192.168.99.253\"})",
     "legendFormat": "IX #2",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "3": {
         "text": "Master（担当）",
         "color": "green",
         "index": 0
        },
        "2": {
         "text": "Backup（待機）",
         "color": "blue",
         "index": 1
        },
        "1": {
         "text": "起動中",
         "color": "orange",
         "index": 2
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "alignValue": "center",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
